# ============================================
# OPAL Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
#   cp .env.example .env
#
# Le service relayer a son propre gabarit : relayer/.env.example
# (clés API opérateurs, supervision, chemin du registre bénéficiaires).
# ============================================

# --------------------------------------------
# Déployeur
# --------------------------------------------
# Clé privée du déployeur — détient DEFAULT_ADMIN_ROLE + ADMIN_ROLE sur FloodPrediction
PRIVATE_KEY=your_private_key_here

# --------------------------------------------
# RPC
# --------------------------------------------
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --------------------------------------------
# Clés d'API des explorateurs (vérification des contrats)
# --------------------------------------------
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# ============================================
# SÉPARATION DES RÔLES — OBLIGATOIRE HORS RÉSEAU LOCAL
# ============================================
# initialize() exige quatre adresses DISTINCTES (erreur RolesNotDistinct sinon).
# Sur un réseau local, des signataires Hardhat servent de repli ; ailleurs ces
# variables sont requises et le déploiement échoue sans elles.

# Crée les triggers et traite les lots de paiement
OPERATOR_ADDRESS=

# SEULE adresse habilitée aux mises à niveau UUPS.
# scripts/upgrade-contract.js doit être signé par cette clé, pas par le déployeur.
UPGRADER_ADDRESS=

# Arrêt d'urgence (pause / unpause)
PAUSER_ADDRESS=

# ============================================
# SERVICE RELAYER (hors chaîne)
# ============================================
# Portefeuille du service relayer : autorisé sur MobileMoneyProvider (règlement)
# et sur WASDIOracleConnector (soumission satellite). Clé CHAUDE — elle signe en
# continu. À isoler du reste et à surveiller.
RELAYER_ADDRESS=

# Mode de paiement du relayeur (correctif A8-05). La simulation confirme les paiements
# ON-CHAIN comme s'ils avaient été exécutés, sans qu'aucun argent ne bouge : c'est une
# aide au développement, jamais un état de production.
#   - non renseigné / "false" : mode RÉEL. Au moins une clé opérateur est alors exigée,
#     sinon le relayeur refuse de démarrer.
#   - "true" : simulation. Refusée sur toute chaîne autre que locale (1337 / 31337).
# Auparavant, l'absence de clé opérateur basculait silencieusement en simulation — un
# secret non monté suffisait à faire confirmer des versements qui n'existaient pas.
SIMULATE_PAYMENTS=false

# ============================================
# GOUVERNANCE
# ============================================
# Acteurs additionnels, séparés par des virgules. initialize() n'enregistre que le
# propriétaire : sans ces adresses, activeActorCount reste sous le quorum et AUCUNE
# proposition ne peut jamais s'exécuter (correctif A76).
#   deploy-amoy.js       : quorum 3 → au moins 2 adresses ici
#   deploy-upgradeable.js: quorum 2 → au moins 1 adresse ici
GOVERNANCE_ACTORS=

# Clés privées de cosignataires, séparées par des virgules — utilisées UNIQUEMENT par
# scripts/accept-spoke-ownership.js pour atteindre le quorum. Ne pas conserver dans un
# .env de production : passer la variable à la commande, le temps de l'opération.
GOVERNANCE_SIGNER_KEYS=

# Transfert de la propriété des 5 contrats immuables vers la gouvernance (ARCH-02).
# Valeur par défaut : true. Poser false pour différer — les contrats restent alors sous
# la clé du déployeur, hors du périmètre multi-signatures.
TRANSFER_SPOKES_TO_GOVERNANCE=true

# Transfert des rôles d'administration du HUB (FloodPredictionContract) vers la
# gouvernance (correctif A8-04). ARCH-02 ne couvrait que les spokes : le contrat qui
# décide qui est payé restait sous DEFAULT_ADMIN_ROLE d'une clé unique, capable de
# repointer le contrôle KYC ou le ciblage sans quorum ni délai.
# Valeur par défaut : true. L'opération est SANS RETOUR (renonciation de rôle), et le
# script refuse de l'exécuter si le quorum de gouvernance n'est pas atteignable.
TRANSFER_HUB_TO_GOVERNANCE=true

# ============================================
# CONFORMITÉ (KYC/AML)
# ============================================
# Officiers de conformité additionnels, séparés par des virgules (correctif A8-03).
# Le constructeur de KYCAMLCompliance n'enregistre QUE le déployeur, et
# approveAttestation() impose la règle des quatre yeux : l'approbateur doit différer du
# soumissionnaire. Avec un seul officier, aucune attestation ne peut être approuvée,
# donc AUCUN bénéficiaire ne peut être payé. Les scripts de déploiement échouent tant
# qu'il y a moins de 2 officiers.
COMPLIANCE_OFFICERS=

# ============================================
# ORACLES
# ============================================
# Adresses d'oracles, séparées par des virgules. Il en faut au moins
# MIN_ORACLE_COUNT (4) actives, sinon le consensus n'est jamais calculé et
# createFloodTrigger accepte n'importe quel score d'opérateur sans contre-vérification
# (correctif A59 — verify-deployment.js échoue tant que la condition n'est pas remplie).
ORACLE_ADDRESSES=

# ============================================
# MISE À NIVEAU
# ============================================
# Adresse du proxy à mettre à niveau (scripts/upgrade-contract.js)
PROXY_ADDRESS=
